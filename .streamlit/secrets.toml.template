# NA Bench Forecast Dashboard — Streamlit Secrets template
# Copy this file to .streamlit/secrets.toml and fill in your values.
# On Streamlit Cloud, paste the key=value pairs directly into the Secrets editor.

# --- Access gate -----------------------------------------------------------
# Uncomment and set a password to require users to enter a code before viewing.
# [auth]
# password = "your-access-code"

# --- Editing lock ----------------------------------------------------------
# Set to true to make the entire forecast table read-only for all users.
# [lock]
# editing = false

# --- Actuals cutoff --------------------------------------------------------
# Controls how many weeks from the start are treated as locked "actual bench".
# Wk 01 through actuals_through will be gray + uneditable in the edit form.
# Advance this by 1 each week as actuals are confirmed.
# Valid range: 0 (all weeks editable) – 13 (all weeks locked).
# When this key is absent (or secrets.toml doesn't exist), the dashboard will
# auto-detect the cutoff from the Excel file: it counts contiguous leading weeks
# where every center row has a non-zero value.
[forecast]
actuals_through = 7
